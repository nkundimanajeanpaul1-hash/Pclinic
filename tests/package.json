{
  "name": "pclinic-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test:static": "node --test dashboard-role-contracts.test.mjs",
    "test:rules": "firebase emulators:exec --config ../firebase.json --project demo-pclinic --only firestore \"node --test firestore.rules.test.mjs\"",
    "test:all": "npm run test:static && npm run test:files && npm run test:results && npm run test:call-errors && npm run test:rules",
    "test:files": "node --test pclinic-file-sync.test.mjs",
    "test:results": "node --test imaging-results-page.test.mjs",
    "test:call-errors": "node --test radiology-call-errors.test.mjs"
  },
  "dependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.18.0",
    "firebase-tools": "13.35.1"
  }
}
