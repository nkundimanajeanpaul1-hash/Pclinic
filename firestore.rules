rules_version = '2';

// PCLINIC — EMERGENCY SECURITY BASELINE
// Deploy only after running the emulator tests in tests/.
// This is a transitional ruleset for the current monolithic patient model.
// It removes public/date-based access, denies unknown collections, restricts
// non-clinical roles, validates staff profiles, protects immutable ownership
// fields, and removes the pre-authorized wildcard patient subcollection.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    // Missing `active` is denied. Every staff profile must be explicit.
    function activeStaff() {
      return hasProfile() && profile().get('active', false) == true;
    }

    function role() {
      return hasProfile() ? profile().get('role', '') : '';
    }

    function staffId() {
      return hasProfile() ? profile().get('staffId', '') : '';
    }

    function isAdmin() {
      return activeStaff() && role() == 'admin';
    }

    function hasRole(allowed) {
      return activeStaff() && (isAdmin() || role() in allowed);
    }

    function validRole(value) {
      return value in [
        'admin', 'doctor', 'nurse', 'reception', 'lab', 'pharmacy',
        'radio', 'physio', 'cashier', 'finance', 'hr', 'inventory',
        'theater', 'beds'
      ];
    }

    function validProfile(data) {
      return data.keys().hasOnly([
          'staffId', 'name', 'role', 'active', 'createdAt', 'createdBy'
        ])
        && data.staffId is string
        && data.staffId.matches('^[0-9]{1,20}$')
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 120
        && data.role is string
        && validRole(data.role)
        && data.active is bool;
    }

    function patientReader() {
      // HR, inventory, cashier and finance must use their own collections and
      // cannot read the monolithic clinical patient record.
      return hasRole([
        'doctor', 'nurse', 'reception', 'lab', 'pharmacy', 'radio',
        'physio', 'theater', 'beds'
      ]);
    }

    function patientUpdater() {
      return hasRole([
        'doctor', 'nurse', 'reception', 'lab', 'pharmacy', 'radio',
        'physio', 'theater', 'beds'
      ]);
    }

    function patientIdentityIsImmutable() {
      return request.resource.data.get('id', null) == resource.data.get('id', null)
        && request.resource.data.get('mrn', '') == resource.data.get('mrn', '')
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('createdById', '') == resource.data.get('createdById', '');
    }

    function validOrderStatus(value) {
      return value in ['pending', 'in-progress', 'completed', 'cancelled'];
    }

    function orderReader(data) {
      return activeStaff() && (
        isAdmin()
        || role() in ['doctor', 'nurse', 'reception', 'cashier', 'finance', 'lab', 'pharmacy', 'physio', 'theater']
        || (role() == 'radio' && data.get('dept', '') == 'radiology')
      );
    }

    function departmentMayUpdateOrder(data) {
      return isAdmin()
        || data.get('orderedById', '') == staffId()
        || (data.get('dept', '') == 'lab' && role() == 'lab')
        // Radiology transitions are performed by trusted callable functions,
        // not direct browser writes, so finalisation and audit are atomic.
        || (data.get('dept', '') == 'pharmacy' && role() == 'pharmacy')
        || (data.get('dept', '') == 'physio' && role() == 'physio')
        || (data.get('dept', '') == 'theatre' && role() == 'theater')
        || (data.get('dept', '') == 'nursing' && role() == 'nurse');
    }

    function messageAddressedToCaller(data) {
      return isAdmin()
        || data.get('toStaffId', '') == staffId()
        || (data.get('toRoles', []) is list && data.get('toRoles', []).hasAny([role()]));
    }

    // ── STAFF PROFILES ───────────────────────────────────────────
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isAdmin() && validProfile(request.resource.data);

      // Supports one-time deletion of legacy `initialPassword`: the resulting
      // document must contain only the approved profile fields.
      allow update: if isAdmin()
        && validProfile(request.resource.data)
        && request.resource.data.staffId == resource.data.staffId
        && !(request.auth.uid == userId
          && (request.resource.data.active != resource.data.active
            || request.resource.data.role != resource.data.role));

      // Deactivate instead. Permanent Auth deletion belongs in an Admin SDK
      // backend and must not destroy the profile/audit linkage.
      allow delete: if false;
    }

    // ── PATIENTS — TRANSITIONAL MONOLITH ─────────────────────────
    match /patients/{patientId} {
      allow read: if patientReader();

      allow create: if hasRole(['reception'])
        && request.resource.data.get('mrn', '') == patientId
        && request.resource.data.get('createdById', '') == staffId()
        && request.resource.data.get('photo', null) == null
        && !request.resource.data.keys().hasAny(['photos', 'videos', 'media', 'attachments', 'consentFile']);

      allow update: if patientUpdater()
        && patientIdentityIsImmutable()
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['photo', 'photos', 'videos', 'media', 'attachments', 'consentFile']);
      allow delete: if isAdmin();

      // The current application stores official forms here. No other future
      // subcollection receives blanket access.
      match /files/{fileId} {
        allow read: if patientReader();
        allow create, update: if hasRole([
          'doctor', 'nurse', 'reception', 'lab', 'radio', 'physio', 'theater'
        ])
        && (request.resource.data.get('patientId', null) == patientId
          || request.resource.data.get('patientId', null)
            == get(/databases/$(database)/documents/patients/$(patientId)).data.get('id', null))
        && !request.resource.data.keys().hasAny([
          'data', 'attachment', 'photo', 'photos', 'video', 'videos', 'media'
        ])
        && (!request.resource.data.keys().hasAny(['attachments'])
          || (request.resource.data.attachments is list
            && request.resource.data.attachments.size() == 0));
        allow delete: if isAdmin();
      }

      match /{unknownSubcollection}/{documentId} {
        allow read, write: if false;
      }
    }

    // ── ORDERS ───────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if orderReader(resource.data);

      allow create: if hasRole(['doctor', 'nurse', 'reception'])
        && request.resource.data.get('id', '') == orderId
        && request.resource.data.get('orderedById', '') == staffId()
        && request.resource.data.get('status', '') == 'pending';

      allow update: if orderReader(resource.data)
        && departmentMayUpdateOrder(resource.data)
        && request.resource.data.get('id', '') == resource.data.get('id', '')
        && request.resource.data.get('patientId', '') == resource.data.get('patientId', '')
        && request.resource.data.get('orderedById', '') == resource.data.get('orderedById', '')
        && request.resource.data.get('orderedAt', '') == resource.data.get('orderedAt', '')
        && validOrderStatus(request.resource.data.get('status', ''));

      allow delete: if false;
    }

    // ── LABORATORY REPORTING ──────────────────────────────────────
    // Final reports, drafts, critical alerts and audit entries are written by
    // trusted callable functions. Browser clients are read-only so a released
    // result cannot be silently overwritten from developer tools.
    match /labResults/{resultId} {
      allow read: if hasRole(['doctor', 'nurse', 'lab']);
      allow write: if false;
    }

    match /labResultDrafts/{draftId} {
      allow read: if hasRole(['lab']);
      allow write: if false;
    }

    match /labCriticalAlerts/{alertId} {
      allow read: if hasRole(['doctor', 'nurse', 'lab']);
      allow write: if false;
    }

    // ── RADIOLOGY REPORTING ───────────────────────────────────────
    // Reports, addenda and critical alerts are written only by trusted
    // callable functions using the Admin SDK. Browser clients are read-only.
    match /radiologyReports/{reportId} {
      allow read: if hasRole(['doctor', 'nurse', 'radio']);
      allow write: if false;
    }

    match /radiologyAddenda/{addendumId} {
      allow read: if hasRole(['doctor', 'nurse', 'radio']);
      allow write: if false;
    }

    match /criticalAlerts/{alertId} {
      allow read: if hasRole(['doctor', 'nurse', 'radio']);
      allow write: if false;
    }

    // ── BILLS ────────────────────────────────────────────────────
    match /bills/{billId} {
      allow read: if hasRole(['cashier', 'finance']);

      allow create: if hasRole(['doctor', 'nurse', 'reception'])
        && request.resource.data.get('id', '') == billId
        && request.resource.data.get('createdById', '') == staffId()
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('paid', 0) == 0;

      allow update: if hasRole(['cashier', 'finance'])
        && request.resource.data.get('id', '') == resource.data.get('id', '')
        && request.resource.data.get('patientId', '') == resource.data.get('patientId', '')
        && request.resource.data.get('createdById', '') == resource.data.get('createdById', '')
        && request.resource.data.get('createdAt', '') == resource.data.get('createdAt', '')
        && request.resource.data.get('status', '') in ['pending', 'partial', 'paid', 'cancelled']
        && request.resource.data.get('total', -1) is number
        && request.resource.data.get('paid', -1) is number
        && request.resource.data.get('balance', -1) is number
        && request.resource.data.total >= 0
        && request.resource.data.paid >= 0
        && request.resource.data.balance >= 0
        && request.resource.data.paid <= request.resource.data.total
        && request.resource.data.balance == request.resource.data.total - request.resource.data.paid;

      allow delete: if false;
    }

    // ── MESSAGES ─────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if activeStaff() && messageAddressedToCaller(resource.data);

      allow create: if activeStaff()
        && request.resource.data.get('id', '') == messageId
        && request.resource.data.get('fromId', '') == staffId()
        && request.resource.data.get('fromRole', '') == role()
        && request.resource.data.get('readBy', []) is list
        && request.resource.data.get('readBy', []).size() == 0;

      allow update: if activeStaff()
        && messageAddressedToCaller(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && request.resource.data.readBy is list
        && request.resource.data.readBy.hasAll(resource.data.get('readBy', []))
        && request.resource.data.readBy.hasAny([staffId()])
        && request.resource.data.readBy.size() <= resource.data.get('readBy', []).size() + 1;

      allow delete: if isAdmin();
    }

    // ── PATIENT ID COUNTER ───────────────────────────────────────
    match /config/patientCounter {
      allow get: if hasRole(['reception']);

      allow create: if hasRole(['reception'])
        && request.resource.data.keys().hasOnly(['lastId', 'updatedAt'])
        && request.resource.data.lastId is int
        && request.resource.data.lastId >= 1001;

      allow update: if hasRole(['reception'])
        && request.resource.data.keys().hasOnly(['lastId', 'updatedAt'])
        && request.resource.data.lastId is int
        && request.resource.data.lastId == resource.data.lastId + 1;

      allow delete: if false;
    }

    // Other configuration documents (tariffs/catalogues) are admin-managed.
    match /config/{docId} {
      allow read: if activeStaff();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Audit events will be written by a trusted backend. Client-created audit
    // events are denied so the UI cannot forge evidence.
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Deny drug references and every unknown collection from browser clients.
    // The Admin SDK backend bypasses rules and performs its own authorization.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
