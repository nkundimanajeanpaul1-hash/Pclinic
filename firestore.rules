rules_version = '2';

// PCLINIC — EMERGENCY SECURITY BASELINE
// Deploy only after running the emulator tests in tests/.
// This is a transitional ruleset for the current monolithic patient model.
// It removes public/date-based access, denies unknown collections, restricts
// non-clinical roles, validates staff profiles, protects immutable ownership
// fields, and removes the pre-authorized wildcard patient subcollection.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    // Missing `active` is denied. Every staff profile must be explicit.
    function activeStaff() {
      return hasProfile() && profile().get('active', false) == true;
    }

    function role() {
      return hasProfile() ? profile().get('role', '') : '';
    }

    function staffId() {
      return hasProfile() ? profile().get('staffId', '') : '';
    }

    function isAdmin() {
      return activeStaff() && role() == 'admin';
    }

    function hasRole(allowed) {
      return activeStaff() && (isAdmin() || role() in allowed);
    }

    function validRole(value) {
      return value in [
        'admin', 'doctor', 'nurse', 'reception', 'lab', 'pharmacy',
        'radio', 'physio', 'cashier', 'finance', 'hr', 'inventory',
        'theater', 'beds'
      ];
    }

    function validProfile(data) {
      return data.keys().hasOnly([
          'staffId', 'name', 'role', 'active', 'createdAt', 'createdBy'
        ])
        && data.staffId is string
        && data.staffId.matches('^[0-9]{1,20}$')
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 120
        && data.role is string
        && validRole(data.role)
        && data.active is bool;
    }

    function patientReader() {
      // HR, inventory, cashier and finance must use their own collections and
      // cannot read the monolithic clinical patient record.
      return hasRole([
        'doctor', 'nurse', 'reception', 'lab', 'pharmacy', 'radio',
        'physio', 'theater', 'beds'
      ]);
    }

    function patientUpdater() {
      return hasRole([
        'doctor', 'nurse', 'reception', 'lab', 'pharmacy', 'radio',
        'physio', 'theater', 'beds'
      ]);
    }

    function patientIdentityIsImmutable() {
      return request.resource.data.get('id', null) == resource.data.get('id', null)
        && request.resource.data.get('mrn', '') == resource.data.get('mrn', '')
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('createdById', '') == resource.data.get('createdById', '');
    }

    function validOrderStatus(value) {
      return value in ['pending', 'in-progress', 'completed', 'cancelled'];
    }

    function orderReader(data) {
      return activeStaff() && (
        isAdmin()
        || role() in ['doctor', 'nurse', 'reception', 'cashier', 'finance', 'lab', 'pharmacy', 'physio', 'theater']
        || (role() == 'radio' && data.get('dept', '') == 'radiology')
      );
    }

    function departmentMayUpdateOrder(data) {
      return isAdmin()
        || data.get('orderedById', '') == staffId()
        || (data.get('dept', '') == 'lab' && role() == 'lab')
        // Radiology transitions are performed by trusted callable functions,
        // not direct browser writes, so finalisation and audit are atomic.
        || (data.get('dept', '') == 'pharmacy' && role() == 'pharmacy')
        || (data.get('dept', '') == 'physio' && role() == 'physio')
        || (data.get('dept', '') == 'theatre' && role() == 'theater')
        || (data.get('dept', '') == 'nursing' && role() == 'nurse');
    }

    function messageAddressedToCaller(data) {
      return isAdmin()
        || data.get('toStaffId', '') == staffId()
        || (data.get('toRoles', []) is list && data.get('toRoles', []).hasAny([role()]));
    }

    // ── STAFF PROFILES ───────────────────────────────────────────
    // Profiles contain only staffId/name/role/active (no email, phone,
    // password). Clinical roles read them to select staff by immutable
    // staffId (e.g. reception booking an appointment with a doctor).
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || activeStaff() || isAdmin());
      allow list: if isAdmin()
        || (activeStaff() && role() in ['reception','doctor','nurse','theater','beds','hr']);

      allow create: if isAdmin() && validProfile(request.resource.data);

      // Supports one-time deletion of legacy `initialPassword`: the resulting
      // document must contain only the approved profile fields.
      allow update: if isAdmin()
        && validProfile(request.resource.data)
        && request.resource.data.staffId == resource.data.staffId
        && !(request.auth.uid == userId
          && (request.resource.data.active != resource.data.active
            || request.resource.data.role != resource.data.role));

      // Deactivate instead. Permanent Auth deletion belongs in an Admin SDK
      // backend and must not destroy the profile/audit linkage.
      allow delete: if false;
    }

    // ── PATIENTS — TRANSITIONAL MONOLITH ─────────────────────────
    match /patients/{patientId} {
      allow read: if patientReader();

      allow create: if hasRole(['reception'])
        && request.resource.data.get('mrn', '') == patientId
        && request.resource.data.get('createdById', '') == staffId()
        && request.resource.data.get('photo', null) == null
        && !request.resource.data.keys().hasAny(['photos', 'videos', 'media', 'attachments', 'consentFile']);

      allow update: if patientUpdater()
        && patientIdentityIsImmutable()
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['photo', 'photos', 'videos', 'media', 'attachments', 'consentFile']);
      allow delete: if isAdmin();

      // The current application stores official forms here. No other future
      // subcollection receives blanket access.
      match /files/{fileId} {
        allow read: if patientReader();
        allow create, update: if hasRole([
          'doctor', 'nurse', 'reception', 'lab', 'radio', 'physio', 'theater'
        ])
        && (request.resource.data.get('patientId', null) == patientId
          || request.resource.data.get('patientId', null)
            == get(/databases/$(database)/documents/patients/$(patientId)).data.get('id', null))
        && !request.resource.data.keys().hasAny([
          'data', 'attachment', 'photo', 'photos', 'video', 'videos', 'media'
        ])
        && (!request.resource.data.keys().hasAny(['attachments'])
          || (request.resource.data.attachments is list
            && request.resource.data.attachments.size() == 0));
        allow delete: if isAdmin();
      }

      match /{unknownSubcollection}/{documentId} {
        allow read, write: if false;
      }
    }

    // ── ORDERS ───────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if orderReader(resource.data);

      allow create: if hasRole(['doctor', 'nurse', 'reception'])
        && request.resource.data.get('id', '') == orderId
        && request.resource.data.get('orderedById', '') == staffId()
        && request.resource.data.get('status', '') == 'pending';

      allow update: if orderReader(resource.data)
        && departmentMayUpdateOrder(resource.data)
        && request.resource.data.get('id', '') == resource.data.get('id', '')
        && request.resource.data.get('patientId', '') == resource.data.get('patientId', '')
        && request.resource.data.get('orderedById', '') == resource.data.get('orderedById', '')
        && request.resource.data.get('orderedAt', '') == resource.data.get('orderedAt', '')
        && validOrderStatus(request.resource.data.get('status', ''));

      allow delete: if false;
    }

    // ── LABORATORY REPORTING ──────────────────────────────────────
    // Final reports, drafts, critical alerts and audit entries are written by
    // trusted callable functions. Browser clients are read-only so a released
    // result cannot be silently overwritten from developer tools.
    match /labResults/{resultId} {
      allow read: if hasRole(['doctor', 'nurse', 'lab']);
      allow write: if false;
    }

    match /labResultDrafts/{draftId} {
      allow read: if hasRole(['lab']);
      allow write: if false;
    }

    match /labCriticalAlerts/{alertId} {
      allow read: if hasRole(['doctor', 'nurse', 'lab']);
      allow write: if false;
    }

    // ── LAB QUALITY CONTROL LOGS ─────────────────────────────────
    // One document per analyzer per day, written by lab staff so QC moves
    // out of localStorage and becomes server-authoritative across devices.
    match /labQcLogs/{logId} {
      allow read: if hasRole(['lab']);
      allow create, update: if hasRole(['lab'])
        && request.resource.data.get('analyzer', '') is string
        && request.resource.data.get('date', '') is string;
      allow delete: if isAdmin();
    }

    // ── BLOOD BANK INVENTORY ──────────────────────────────────────
    // Live unit counts are managed by laboratory / blood-bank staff.
    match /bloodBankInventory/{entryId} {
      allow read: if hasRole(['lab']);
      allow create, update: if hasRole(['lab'])
        && request.resource.data.get('product', '') is string
        && request.resource.data.get('group', '') is string;
      allow delete: if isAdmin();
    }

    // ── RADIOLOGY REPORTING ───────────────────────────────────────
    // Reports, addenda and critical alerts are written only by trusted
    // callable functions using the Admin SDK. Browser clients are read-only.
    match /radiologyReports/{reportId} {
      allow read: if hasRole(['doctor', 'nurse', 'radio']);
      allow write: if false;
    }

    match /radiologyAddenda/{addendumId} {
      allow read: if hasRole(['doctor', 'nurse', 'radio']);
      allow write: if false;
    }

    match /criticalAlerts/{alertId} {
      allow read: if hasRole(['doctor', 'nurse', 'radio']);
      allow write: if false;
    }

    // ── RADIOLOGY STUDY MEDIA (images / web video) ────────────────────
    // Records hold metadata and a Storage path only. Pixels live in the
    // private bucket and are read through short-lived signed URLs minted by
    // the radiologyMediaSign callable, so no clinical role can read another
    // patient's image by editing a URL, and no browser can overwrite a filed
    // study: create is allowed (the uploader records what it just stored),
    // update never, delete only by the uploader so a wrong upload can be
    // undone before the study is signed.
    match /radiologyMedia/{mediaId} {
      function safeMediaWrite() {
        return request.resource.data.keys().hasOnly([
            'id', 'orderId', 'patientId', 'fileName', 'mime', 'kind',
            'bytes', 'storagePath', 'ext', 'sha256', 'at', 'byUid', 'byId', 'byName', 'byRole'
          ])
          && request.resource.data.get('kind', null) in ['image', 'video']
          && request.resource.data.get('mime', null) in [
              'image/jpeg', 'image/png', 'image/webp', 'image/gif',
              'video/mp4', 'video/webm', 'application/dicom']
          && request.resource.data.get('bytes', 0) is int
          && request.resource.data.get('bytes', null) > 0
          && request.resource.data.get('bytes', null) <= 26214400
          && request.resource.data.get('byUid', null) == request.auth.uid
          && request.resource.data.get('storagePath', '') is string
          && request.resource.data.get('storagePath', null).matches('^radiology/([A-Za-z0-9._-]{1,120})/([A-Za-z0-9._-]{1,160})$')
          && request.resource.data.get('patientId', null) != null
          && request.resource.data.get('orderId', '') is string
          // The object must sit under the very order this record describes. The
          // stored name carries an extension the rules cannot derive from an id,
          // so the uploader declares it in `ext` and the two must agree; the
          // callable re-checks before signing anything.
          && request.resource.data.get('ext', null) is string
          && request.resource.data.get('ext', null).matches('^[a-z0-9]{2,4}$')
          && request.resource.data.get('storagePath', null)
               == 'radiology/' + request.resource.data.get('orderId', null) + '/' + request.resource.data.get('id', null) + '.' + request.resource.data.get('ext', null)
          && request.resource.data.get('fileName', '') is string
          && request.resource.data.get('fileName', null).size() <= 240
          && !request.resource.data.keys().hasAny(['data', 'dataUrl', 'base64', 'photo', 'photos', 'video', 'videos']);
      }

      allow get, list: if patientReader();

      allow create: if hasRole(['radio', 'admin'])
        && activeStaff()
        && request.resource.data.get('id', null) == mediaId
        && safeMediaWrite()
        && exists(/databases/$(database)/documents/orders/$(request.resource.data.get('orderId', null)))
        // patientId is a NUMBER on patients/orders (e.g. 1001) but the media
        // uploader stores it as a STRING ("1001"). A raw `==` here is
        // type-sensitive, so number != string and every upload was denied as
        // "permission denied" even though the IDs were the same. Cast both
        // sides to string so the linkage check is type-agnostic.
        && string(get(/databases/$(database)/documents/orders/$(request.resource.data.get('orderId', null))).data.get('patientId', ''))
             == string(request.resource.data.get('patientId', ''));

      allow update: if false;
      // Uploader-only, admin included: letting a supervisor remove a
      // filed study image silently would destroy evidence of what was
      // reviewed. Admins act on the order, not on other people's files.
      allow delete: if activeStaff()
        && resource.data.get('byUid', null) == request.auth.uid;
    }

    // ── RADIOLOGY ANNOTATIONS (workstation drawings, key images, notes) ──
    // One document per image per author: radiologyAnnotations/{mediaId}_{uid}.
    // It only DESCRIBES measurements drawn on top of an image (tool + JSON
    // handles), a key-image flag and a short note — never pixels. Every
    // clinical role that may read the patient sees everyone's annotations;
    // only the author (doctor, radio, admin) writes or deletes their own, and
    // only for an image record that really exists in radiologyMedia.
    match /radiologyAnnotations/{annotationId} {
      function safeAnnotation() {
        return request.resource.data.keys().hasOnly([
            'id', 'mediaId', 'orderId', 'patientId', 'measurements', 'keyImage', 'note',
            'byUid', 'byId', 'byName', 'byRole', 'updatedAt', 'client'
          ])
          && request.resource.data.get('id', null) == annotationId
          && request.resource.data.get('byUid', null) == request.auth.uid
          && request.resource.data.get('mediaId', null) is string
          && request.resource.data.get('mediaId', null).matches('^[A-Za-z0-9._-]{1,120}$')
          && annotationId == request.resource.data.get('mediaId', null) + '_' + request.auth.uid
          && request.resource.data.get('orderId', null) is string
          && request.resource.data.get('orderId', null).size() > 0
          && request.resource.data.get('patientId', '') is string
          && request.resource.data.get('measurements', null) is list
          && request.resource.data.get('measurements', null).size() <= 300
          && request.resource.data.get('keyImage', null) is bool
          && request.resource.data.get('note', null) is string
          && request.resource.data.get('note', null).size() <= 4000
          && request.resource.data.get('updatedAt', null) is string
          && request.resource.data.get('byName', '') is string
          && request.resource.data.get('byName', '').size() <= 120
          && !request.resource.data.keys().hasAny(['data', 'dataUrl', 'base64', 'photo', 'photos', 'video', 'videos']);
      }
      function mediaPath() {
        return /databases/$(database)/documents/radiologyMedia/$(request.resource.data.get('mediaId', null));
      }

      allow get, list: if patientReader();

      allow create: if hasRole(['doctor', 'radio', 'admin'])
        && safeAnnotation()
        && exists(mediaPath())
        && get(mediaPath()).data.get('orderId', '') == request.resource.data.get('orderId', null)
        && string(get(mediaPath()).data.get('patientId', '')) == string(request.resource.data.get('patientId', ''));

      // Authors edit their own document only, and cannot re-point it at another image.
      allow update: if hasRole(['doctor', 'radio', 'admin'])
        && safeAnnotation()
        && resource.data.get('byUid', null) == request.auth.uid
        && request.resource.data.get('mediaId', null) == resource.data.get('mediaId', null)
        && request.resource.data.get('orderId', null) == resource.data.get('orderId', null);

      allow delete: if activeStaff()
        && resource.data.get('byUid', null) == request.auth.uid;
    }

    // ── RESTRICTED BILLING PATIENT DIRECTORY ─────────────────────
    // Contains no clinical notes, diagnoses, contact details or national ID.
    match /billingPatientDirectory/{patientId} {
      allow read: if hasRole(['reception', 'cashier', 'finance']);
      allow create, update: if hasRole(['reception'])
        && request.resource.data.get('id', '') == patientId
        && request.resource.data.keys().hasOnly([
          'id','mrn','name','firstName','lastName','insuranceProvider',
          'patientPayPercent','active','updatedAt'
        ])
        && request.resource.data.get('patientPayPercent', -1) is number
        && request.resource.data.get('patientPayPercent', -1) >= 0
        && request.resource.data.get('patientPayPercent', -1) <= 100;
      allow delete: if isAdmin();
    }

    // ── AUTHORITATIVE BED REGISTRY ────────────────────────────────
    // Reception/Nurse may only assign (available → occupied/reserved) or
    // release (→ available) a bed without changing its identity (ward/number).
    // Full lifecycle (maintenance, renumbering) stays with Beds/Admin.
    match /beds/{bedId} {
      allow read: if hasRole(['reception','nurse','beds','theater']);
      allow create: if hasRole(['beds'])
        && request.resource.data.get('id','') == bedId
        && request.resource.data.get('status','') in ['available','occupied','reserved','maintenance','unavailable'];
      allow update: if (hasRole(['beds'])
        && request.resource.data.get('id','') == bedId
        && request.resource.data.get('status','') in ['available','occupied','reserved','maintenance','unavailable'])
        || (hasRole(['reception','nurse'])
        && request.resource.data.get('id','') == bedId
        && request.resource.data.get('ward','') == resource.data.get('ward','')
        && request.resource.data.get('bedNumber','') == resource.data.get('bedNumber','')
        && request.resource.data.get('status','') in ['available','occupied','reserved']);
      allow delete: if isAdmin();
    }

    // ── OPERATING THEATER SCHEDULE ────────────────────────────────
    // A DOCTOR books a surgery and advances its status (scheduled →
    // in-progress → completed / delayed / cancelled). Every other role
    // can only VIEW the booked list. A surgery keeps its identity
    // (id / createdById) across status updates so the audit trail
    // cannot be rewritten from the browser.
    match /theaterSurgeries/{surgeryId} {
      allow read: if hasRole(['doctor', 'nurse', 'reception', 'theater', 'beds']);

      allow create: if hasRole(['doctor'])
        && request.resource.data.get('id', '') == surgeryId
        && request.resource.data.get('createdById', '') == staffId()
        && request.resource.data.get('status', '') == 'scheduled';

      allow update: if hasRole(['doctor'])
        && request.resource.data.get('id', '') == resource.data.get('id', '')
        && request.resource.data.get('createdById', '') == resource.data.get('createdById', '')
        && request.resource.data.get('status', '') in ['scheduled', 'in-progress', 'completed', 'delayed', 'cancelled'];

      allow delete: if isAdmin();
    }

    // ── OPERATING THEATER REGISTRY ────────────────────────────────
    // The list of rooms and their availability, managed by doctors.
    match /theaters/{theaterId} {
      allow read: if hasRole(['doctor', 'nurse', 'reception', 'theater', 'beds']);
      allow create, update: if hasRole(['doctor'])
        && request.resource.data.get('id', '') == theaterId;
      allow delete: if isAdmin();
    }

    // ── HR STAFF RECORDS ─────────────────────────────────────────
    // A dedicated HR-managed directory (richer than the auth profile):
    // name, role, department, contact details, salary/allowances/
    // deductions, leave balances and status. HR manages it; admin too.
    match /staffRecords/{recordId} {
      allow read: if hasRole(['hr', 'admin']);
      allow create, update: if hasRole(['hr', 'admin'])
        && request.resource.data.get('id', '') == recordId;
      allow delete: if isAdmin();
    }

    // ── HR LEAVE REQUESTS ────────────────────────────────────────
    match /leaveRequests/{requestId} {
      allow read: if hasRole(['hr', 'admin']);
      allow create, update: if hasRole(['hr', 'admin'])
        && request.resource.data.get('id', '') == requestId;
      allow delete: if isAdmin();
    }

    // ── HR SHIFT ROSTER (one document per week) ──────────────────
    match /shiftRoster/{weekId} {
      allow read: if hasRole(['hr', 'admin']);
      allow create, update: if hasRole(['hr', 'admin'])
        && request.resource.data.get('id', '') == weekId;
      allow delete: if isAdmin();
    }

    // ── HR JOB POSTINGS ──────────────────────────────────────────
    match /jobPostings/{postingId} {
      allow read: if hasRole(['hr', 'admin']);
      allow create, update: if hasRole(['hr', 'admin'])
        && request.resource.data.get('id', '') == postingId;
      allow delete: if isAdmin();
    }

    // ── SERVER-BACKED STAFF NOTIFICATIONS ─────────────────────────
    match /notifications/{notificationId} {
      allow read: if messageAddressedToCaller(resource.data);
      allow create: if hasRole(['reception','doctor','nurse','lab','radio','theater','beds'])
        && request.resource.data.get('id','') == notificationId
        && request.resource.data.get('createdById','') == staffId()
        && request.resource.data.get('toRoles',[]) is list;
      allow update: if messageAddressedToCaller(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt']);
      allow delete: if isAdmin();
    }

    // ── BILLS ────────────────────────────────────────────────────
    match /bills/{billId} {
      // cashier/finance run the ledger; the admin reads it for the
      // patient-data "Bills" and "Imaging" tabs (deletes go through the
      // adminImagingDelete Cloud Function, never from the browser).
      allow read: if hasRole(['cashier', 'finance', 'admin']);

      allow create: if hasRole(['doctor', 'nurse', 'reception', 'cashier'])
        && request.resource.data.get('id', '') == billId
        && request.resource.data.get('createdById', '') == staffId()
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('paid', 0) == 0;

      allow update: if hasRole(['cashier', 'finance'])
        && request.resource.data.get('id', '') == resource.data.get('id', '')
        && request.resource.data.get('patientId', '') == resource.data.get('patientId', '')
        && request.resource.data.get('createdById', '') == resource.data.get('createdById', '')
        && request.resource.data.get('createdAt', '') == resource.data.get('createdAt', '')
        && request.resource.data.get('status', '') in ['pending', 'partial', 'paid', 'cancelled']
        && request.resource.data.get('total', -1) is number
        && request.resource.data.get('paid', -1) is number
        && request.resource.data.get('balance', -1) is number
        && request.resource.data.total >= 0
        && request.resource.data.paid >= 0
        && request.resource.data.balance >= 0
        && request.resource.data.paid <= request.resource.data.total
        && request.resource.data.balance == request.resource.data.total - request.resource.data.paid;

      allow delete: if false;
    }

    // ── MESSAGES ─────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if activeStaff() && messageAddressedToCaller(resource.data);

      allow create: if activeStaff()
        && request.resource.data.get('id', '') == messageId
        && request.resource.data.get('fromId', '') == staffId()
        && request.resource.data.get('fromRole', '') == role()
        && request.resource.data.get('readBy', []) is list
        && request.resource.data.get('readBy', []).size() == 0;

      allow update: if activeStaff()
        && messageAddressedToCaller(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && request.resource.data.readBy is list
        && request.resource.data.readBy.hasAll(resource.data.get('readBy', []))
        && request.resource.data.readBy.hasAny([staffId()])
        && request.resource.data.readBy.size() <= resource.data.get('readBy', []).size() + 1;

      allow delete: if isAdmin();
    }

    // ── PATIENT ID COUNTER ───────────────────────────────────────
    match /config/patientCounter {
      allow get: if hasRole(['reception']);

      allow create: if hasRole(['reception'])
        && request.resource.data.keys().hasOnly(['lastId', 'updatedAt'])
        && request.resource.data.lastId is int
        && request.resource.data.lastId >= 1001;

      allow update: if hasRole(['reception'])
        && request.resource.data.keys().hasOnly(['lastId', 'updatedAt'])
        && request.resource.data.lastId is int
        && request.resource.data.lastId == resource.data.lastId + 1;

      allow delete: if false;
    }

    // Other configuration documents (tariffs/catalogues) are admin-managed.
    match /config/{docId} {
      allow read: if activeStaff();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Audit events will be written by a trusted backend. Client-created audit
    // events are denied so the UI cannot forge evidence.
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Deny drug references and every unknown collection from browser clients.
    // The Admin SDK backend bypasses rules and performs its own authorization.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
