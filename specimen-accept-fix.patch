index 0000000..321eb5e
--- /dev/null
+++ b/functions/lab-domain.cjs
@@ -0,0 +1,143 @@
+'use strict';
+
+const SPECIMEN_ACTIONS = new Set(['accession', 'reject']);
+const ACTIVE_ORDER_STATES = new Set(['pending', 'in-progress']);
+
+function text(value, max = 500) {
+  return String(value == null ? '' : value).trim().slice(0, max);
+}
+
+function normalizePatientId(value) {
+  return text(value, 200).replace(/^MOD-/i, '').trim();
+}
+
+function normalizeOrderId(value) {
+  const id = text(value, 300);
+  if (!id || id.includes('/')) throw new Error('A valid Firestore order ID is required.');
+  return id;
+}
+
+function normalizeSpecimenAction(value) {
+  const action = text(value, 30).toLowerCase();
+  if (!SPECIMEN_ACTIONS.has(action)) throw new Error('Unknown specimen action.');
+  return action;
+}
+
+function normalizeOrderStatus(value) {
+  const status = text(value || 'pending', 40).toLowerCase();
+  if (status === 'in progress' || status === 'in_progress') return 'in-progress';
+  if (status === 'rejected') return 'cancelled';
+  return status;
+}
+
+function isLaboratoryOrder(order) {
+  return !!order && (text(order.dept, 40).toLowerCase() === 'lab' || text(order.type, 40).toLowerCase() === 'lab');
+}
+
+function transitionDisposition(statusValue, action, hasAccession) {
+  const status = normalizeOrderStatus(statusValue);
+  if (action === 'accession') {
+    if (status === 'in-progress' && hasAccession) return 'already-applied';
+    if (ACTIVE_ORDER_STATES.has(status)) return 'apply';
+    throw new Error(status === 'completed'
+      ? 'A completed laboratory order cannot be accessioned again.'
+      : 'Only a pending or in-progress laboratory order can be accessioned.');
+  }
+  if (status === 'cancelled') return 'already-applied';
+  if (ACTIVE_ORDER_STATES.has(status)) return 'apply';
+  throw new Error('Only a pending or in-progress laboratory order can be rejected.');
+}
+
+function requestTests(request) {
+  if (!request || typeof request !== 'object') return [];
+  const raw = Array.isArray(request.tests)
+    ? request.tests
+    : [request.testName || request.item || request.test].filter(Boolean);
+  return raw.map((value) => text(value && value.name ? value.name : value, 250)).filter(Boolean);
+}
+
+function sameTestSet(left, right) {
+  const normalize = (values) => values.map((value) => text(value, 250).toLowerCase()).filter(Boolean).sort();
+  const a = normalize(left);
+  const b = normalize(right);
+  return a.length > 0 && a.length === b.length && a.every((value, index) => value === b[index]);
+}
+
+function findLegacyRequest(patient, legacyOrder) {
+  const requests = patient && Array.isArray(patient.labRequests) ? patient.labRequests : [];
+  const legacyRequestId = text(legacyOrder && legacyOrder.legacyRequestId, 300);
+  if (legacyRequestId) {
+    const exact = requests.find((request) => text(request && request.id, 300) === legacyRequestId);
+    if (exact) return exact;
+  }
+
+  // Old requests did not always have an ID. Permit a fallback only when both
+  // the complete test set and the original request time agree.
+  const wantedTests = Array.isArray(legacyOrder && legacyOrder.items)
+    ? legacyOrder.items.map((item) => text(item && item.name, 250)).filter(Boolean)
+    : [];
+  const wantedAt = text(legacyOrder && legacyOrder.orderedAt, 100);
+  if (!wantedTests.length || !wantedAt) return null;
+  return requests.find((request) => {
+    const at = text(request && (request.timestamp || request.date || request.orderedAt), 100);
+    return at === wantedAt && sameTestSet(requestTests(request), wantedTests);
+  }) || null;
+}
+
+function legacyOrderIdForRequest(patientId, request, requestIndex) {
+  const normalizedPatientId = normalizePatientId(patientId);
+  const sourceId = request && request.id != null && String(request.id).trim()
+    ? String(request.id)
+    : `${normalizedPatientId}-${requestIndex}`;
+  const safeSourceId = sourceId.replace(/[^a-zA-Z0-9_-]/g, '');
+  return `LAB-LEGACY-${normalizedPatientId}-${safeSourceId}`;
+}
+
+function codeForTest(name) {
+  const compact = text(name, 250).toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 18);
+  return `LAB-${compact || 'TEST'}`;
+}
+
+function materializeLegacyOrder(orderId, patientId, patient, request) {
+  const tests = requestTests(request);
+  if (!tests.length) throw new Error('The matching legacy laboratory request has no tests.');
+  const priorityValue = text(request.priority || 'routine', 30).toLowerCase();
+  const priority = ['routine', 'urgent', 'stat'].includes(priorityValue) ? priorityValue : 'routine';
+  const patientName = text(
+    patient.name || `${patient.firstName || ''} ${patient.lastName || ''}`.trim() || request.patientName,
+    200
+  );
+  return {
+    id: orderId,
+    patientId,
+    patientName,
+    type: 'lab',
+    dept: 'lab',
+    items: tests.map((name) => ({ code: codeForTest(name), name, qty: 1, price: 0 })),
+    priority,
+    notes: text(request.notes || request.clinicalDetails || request.clinicalNotes, 2000),
+    status: normalizeOrderStatus(request.status || 'pending'),
+    total: 0,
+    billed: false,
+    billId: null,
+    orderedBy: text(request.orderedBy || request.requestedBy, 150),
+    orderedById: text(request.orderedById || request.requestedById, 100),
+    orderedAt: text(request.timestamp || request.date || request.orderedAt, 100) || new Date(0).toISOString(),
+    legacyRequestId: text(request.id, 300),
+    legacyMigrated: true,
+  };
+}
+
+module.exports = {
+  normalizePatientId,
+  normalizeOrderId,
+  normalizeSpecimenAction,
+  normalizeOrderStatus,
+  isLaboratoryOrder,
+  transitionDisposition,
+  requestTests,
+  sameTestSet,
+  findLegacyRequest,
+  legacyOrderIdForRequest,
+  materializeLegacyOrder,
+};
